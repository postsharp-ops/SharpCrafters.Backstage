<Project>

    <!-- Publishes a worker executable and packs the result into the deterministic zip archive that the tools package
         of the product embeds. It is imported by the worker executable of every product. -->

    <Import Project="$(MSBuildThisFileDirectory)DeterministicZip.tasks" />

    <Target Name="PackAndZip" AfterTargets="Build">

        <!-- We need to create a web archive that contains static assets. The directory is deleted first, so that the
             archive does not carry the files of an earlier build. -->
        <RemoveDir Directories="$(OutputPath)Packed" />

        <!-- Node reuse is turned off for the publish. The publish runs an MSBuild of its own, whose worker nodes are
             reusable by default; those nodes inherit the output streams that this task redirects and outlive the
             publish, so the streams never reach their end and the build hangs here. -->
        <Exec Command="dotnet publish &quot;$(ProjectPath)&quot; --no-build -o &quot;$(OutputPath)Packed&quot; -c $(Configuration)"
              EnvironmentVariables="MSBUILDDISABLENODEREUSE=1" />

        <CreateDeterministicZip SourceDirectory="$(OutputPath)Packed" DestinationFile="$(OutputZipFile)" PackageBuildDate="$(BuildDate)" />
        <Message Text="$(MSBuildProjectName) -&gt; $(MSBuildProjectDirectory)\$(OutputZipFile)" Importance="High" />
    </Target>

</Project>
