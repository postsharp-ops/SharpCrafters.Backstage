<Project>

    <PropertyGroup>
        <RepoDirectory>$(MSBuildThisFileDirectory)</RepoDirectory>
        <RepoKind>GitHub</RepoKind> <!-- Valid values: AzureRepos | GitHub -->
    </PropertyGroup>

    <Import Project="eng\Versions.props"/>
    <Import Project="eng\Packaging.props"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="EmbeddedSystemTypes.props"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="BuildOptions.props"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="StrongName.props"/>
    <Import Sdk="PostSharp.Engineering.Sdk" Project="SourceLink.props"/>

    <PropertyGroup>
        <SuppressNETCoreSdkPreviewMessage>True</SuppressNETCoreSdkPreviewMessage>

        <!-- CS8002: the Spectre.Console assemblies are not strong-named.
             IDE0028: collection initialization can be simplified. The findings are not resolved yet.
             IDE0031 and IDE0032: features of the C# 14 compiler that are disabled while the SDK is not stable. -->
        <NoWarn>$(NoWarn);SA0001;CS8002;IDE0028;IDE0031;IDE0032</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- The default PackageVersion metadata attribute cannot be used, because Metalama.Vsx merges all Metalama
             assemblies into one and the attributes of the different assemblies can then no longer be distinguished. -->
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BackstagePackageVersion</_Parameter1>
            <_Parameter2>$(Version)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
