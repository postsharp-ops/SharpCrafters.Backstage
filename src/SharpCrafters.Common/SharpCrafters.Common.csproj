<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <RootNamespace>SharpCrafters.Common</RootNamespace>

        <!-- Packaging -->
        <PackageDescription>A small library without dependency, shared by the production assemblies of the Metalama and PostSharp products. It defines the hooks that production code exposes for deterministic testing. This package should only be installed as a dependency.</PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- This project must not have any dependency that flows to consumers. It is referenced by production
             assemblies of every layer, including Metalama.Patterns.Caching.Backend, which must remain usable
             without the rest of Metalama. -->
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SharpCrafters.Common.Abstractions\SharpCrafters.Common.Abstractions.csproj" />
    </ItemGroup>

</Project>
