<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netframework4.7.2;net10.0;netstandard2.0</TargetFrameworks>
        <PackageDescription>The product-independent services of Backstage, the infrastructure of the Metalama and PostSharp products: dependency injection, diagnostics, configuration, telemetry, licensing and user interface. This package should only be installed as a dependency.</PackageDescription>
        <RootNamespace>SharpCrafters.Backstage</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- The files under Threading/ and the process kind files under Diagnostics/ are also compiled into
             Metalama.Framework.CompilerExtensions and Metalama.Framework.DesignTime.Contracts, which can reference
             nothing. This symbol marks the copy that is part of the Backstage services, and therefore the only one
             that takes part in dependency injection. -->
        <DefineConstants>$(DefineConstants);METALAMA_BACKSTAGE</DefineConstants>

        <!-- Marks a copy of those files that can reference SharpCrafters.Common, and therefore has the test
             synchronization points. This is deliberately a separate symbol, because whether an assembly is part of
             the Backstage services and whether it has the hooks are two independent questions: any project that
             compiles these files and gains a reference to SharpCrafters.Common should define this one too. -->
        <DefineConstants>$(DefineConstants);HAS_METALAMA_TESTING_HOOKS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shared source files travel in the package under the shared directory, so that the projects of the
             consuming products that compile them by link find them in the package instead of in this repository.

             NamedLockExtensions.cs is excluded, as its own documentation already said it had to be: it reaches the
             hashing library and the prefix of the product, neither of which a consumer compiling these files by link
             has, and such a consumer composes its lock names itself. Shipping it made the shared set fail to compile
             outside this repository, which nothing here noticed, because every project of this repository compiles
             these files with METALAMA_BACKSTAGE defined. SharedSourcesProbe is what notices it now. -->
        <None Include="Threading\*.cs" Exclude="Threading\NamedLockExtensions.cs" Pack="true" PackagePath="shared\Threading\" />
        <None Include="Diagnostics\ProcessKind.cs;Diagnostics\ProcessKindDetector.cs" Pack="true" PackagePath="shared\Diagnostics\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpCrafters.Common\SharpCrafters.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="System.Collections.Immutable" />
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
        <PackageReference Include="JetBrains.Profiler.SelfApi" Condition="'$(TargetFramework)'!='netstandard2.0'" />
        <PackageReference Include="Microsoft.Bcl.HashCode" />
        <PackageReference Include="System.Text.Json" VersionOverride="$(SystemTextJsonMinVersion)" NoWarn="NU1903" />
        <PackageReference Include="System.IO.Packaging" />
        <PackageReference Include="System.DirectoryServices" />
        <PackageReference Include="Microsoft.Win32.Registry" Condition="'$(TargetFramework)'=='netstandard2.0'" />
        <PackageReference Include="System.Threading.AccessControl" />
        <PackageReference Include="System.Threading.Tasks.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Telemetry\public.key" />
        <EmbeddedResource Include="Telemetry\public.key" LogicalName="SharpCrafters.Backstage.Telemetry.public.key" />
    </ItemGroup>

    <ItemGroup>
        <!-- Only the test projects see the internal types. A product package is a consumer like any other and
             uses the public API, so that what a product needs is what anyone can rely on. -->
        <InternalsVisibleTo Include="SharpCrafters.Backstage.Tests" />
        <InternalsVisibleTo Include="SharpCrafters.Backstage.Testing" />
    </ItemGroup>

</Project>
