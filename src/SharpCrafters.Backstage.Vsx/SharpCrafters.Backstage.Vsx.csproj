<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netframework4.7.2;net10.0;netstandard2.0</TargetFrameworks>
        <!-- Packaging -->
        <PackageDescription>The Backstage product of the PostSharp and Metalama Visual Studio extension, which hosts the Metalama and PostSharp services in one process. This package should only be installed as a dependency.</PackageDescription>
        <RootNamespace>SharpCrafters.Backstage.Vsx</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Metalama.Backstage\Metalama.Backstage.csproj" />
        <ProjectReference Include="..\PostSharp.Backstage\PostSharp.Backstage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    </ItemGroup>

</Project>
