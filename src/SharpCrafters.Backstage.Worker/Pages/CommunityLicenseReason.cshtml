@page
@using SharpCrafters.Backstage.Licensing
@model CommunityLicenseReasonPageModel

<form method="post">
    <h3>@CommunityLicenseReasonExtensions.Question</h3>
    <p>@CommunityLicenseReasonExtensions.Introduction</p>

    <div class="radio-group">
        @foreach (var reason in CommunityLicenseReasonExtensions.SelectableReasons)
        {
            <div class="radio-option">
                <input type="radio" id="reason@(reason)" name="Reason" value="@reason"
                       checked="@(Model.Reason == reason)">
                <label for="reason@(reason)">@reason.GetDescription()</label>
            </div>
        }
    </div>

    <div class="navigation-buttons">
        <div class="back-button">
            @* ReSharper disable once Html.PathError *@
            <a href="/ChooseLicenseKind">&larr; Back</a>
        </div>
        <div class="continue-button">
            <button type="submit">Continue</button>
        </div>
    </div>
</form>


@foreach (var error in Model.ErrorMessages)
{
    <div class="text-danger">
        @error
    </div>
}
