@page
@using System.Linq
@using SharpCrafters.Backstage.Licensing
@using SharpCrafters.Backstage.Licensing.Registration
@model ChooseLicenseKindPageModel
@inject ILicenseRegistrationService LicenseRegistrationService
@inject ILicenseProductCatalog Catalog

<script>
    function submitForm(buttonValue) {
        document.getElementById('action').value = buttonValue;
        document.forms[0].submit();
    }
</script>

<form method="POST">
    <input type="hidden" id="action" name="action" value=""/>

    <div class="arrow-buttons">
        @if (Catalog.HasUnlicensedEdition)
        {
            <div onclick="submitForm('UseOpenSource')">
                <h4>Stay with @Profile.Name Open Source</h4>
                <p>
                    @Profile.Name Open Source is free for everyone, but you won't be able to use the advanced features of Visual
                    Studio Tools for @Profile.Name, architecture validation, or custom code fixes. Ideal for an initial foray,
                    with an easy upgrade path when you're ready for more.
                </p>
            </div>
        }

        @* One choice per edition that the product family offers and that is worth offering during setup. A family
           that has no free edition declares none, and nothing is shown. *@
        @foreach (var edition in Catalog.SelfRegisteredEditions.Where(e => e.SetupTitle != null))
        {
            <div onclick="submitForm('@("Register:" + edition.Alias)')">
                <h4>@edition.SetupTitle</h4>
                <p>@edition.Description</p>
            </div>
        }

        @if (LicenseRegistrationService.CanRegisterTrialEdition)
        {
            <div onclick="submitForm('StartTrial')">
                <h4>Start a 45-day Trial of @Catalog.GetDisplayName(Catalog.EvaluationProduct)</h4>
                <p>Discover the full capabilities of @Catalog.GetDisplayName(Catalog.EvaluationProduct).</p>
                <p>
                    For teams with extended procurement processes, request a
                    <a href="@Model.WebLinks.GetTeamTrial" target="_blank" onclick="event.stopPropagation()">
                        60-day
                        renewable team evaluation key
                    </a>
                    (available for teams of 5 or more developers).
                </p>
            </div>
        }

        <div onclick="submitForm('RegisterKey')">
            <h4>Activate Your License Key</h4>
            <p>Register your license key and associate it with your user profile on this device.</p>
        </div>

        <div onclick="submitForm('Skip')">
            <h4>Choose Repository-Based Licensing</h4>
            <p>
                Choose this option to streamline @Profile.Name license key management through your source repositories,
                eliminating those licensing notifications.
            </p>
        </div>
    </div>

    <div class="navigation-buttons" style="justify-content: flex-start;">
        <div class="back-button">
            <a href="/">&larr; Back</a>
        </div>
    </div>
</form>