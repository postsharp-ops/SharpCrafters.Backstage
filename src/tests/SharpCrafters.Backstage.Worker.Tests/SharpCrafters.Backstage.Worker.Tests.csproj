<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An xunit.v3 test project is an executable. -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <RootNamespace>SharpCrafters.Backstage.Worker.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SharpCrafters.Backstage.Worker\SharpCrafters.Backstage.Worker.csproj" />
        <ProjectReference Include="..\SharpCrafters.Backstage.Testing\SharpCrafters.Backstage.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>EngineeringDataDirectory</_Parameter1>
            <_Parameter2>$(PostSharpEngineeringDataDirectory)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
