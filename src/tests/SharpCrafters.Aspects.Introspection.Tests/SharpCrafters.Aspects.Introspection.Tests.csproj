<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An xunit.v3 test project is an executable. -->
        <OutputType>Exe</OutputType>
        <TargetFrameworks>netframework4.7.2;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <RootNamespace>SharpCrafters.Aspects.Introspection.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SharpCrafters.Aspects.Introspection\SharpCrafters.Aspects.Introspection.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The fixtures: the files of PostSharp.VisualStudio.Tests (Metalama.Vsx, Services/Languages/RoslynCodeParsingServiceTests),
             and a file written by PostSharp 2027.0 for the tests of PostSharp.Patterns.Aggregation. -->
        <None Include="Fixtures\**\*.pssym" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
