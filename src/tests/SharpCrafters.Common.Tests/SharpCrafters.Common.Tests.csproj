<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An xunit.v3 test project is an executable. -->
        <OutputType>Exe</OutputType>
        <TargetFrameworks>netframework4.7.2;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <RootNamespace>SharpCrafters.Common.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SharpCrafters.Common\SharpCrafters.Common.csproj" />
    </ItemGroup>

</Project>
