<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An xunit.v3 test project is an executable. -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <RootNamespace>SharpCrafters.Aspects.Introspection.Query.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SharpCrafters.Aspects.Introspection.Query\SharpCrafters.Aspects.Introspection.Query.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The fixtures of the tests of the reader and writer of version 1. -->
        <None Include="..\SharpCrafters.Aspects.Introspection.Tests\Fixtures\**\*.pssym" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
