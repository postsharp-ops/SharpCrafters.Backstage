<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- An xunit.v3 test project is an executable. -->
        <OutputType>Exe</OutputType>
        <AssemblyName>SharpCrafters.Backstage.PlatformTests</AssemblyName>
        <RootNamespace>SharpCrafters.Backstage.PlatformTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The product, as an application consumes it: through the packages of the build. -->
        <PackageReference Include="Metalama.Backstage" />

        <!-- The commands, which the process management suite runs as a user runs them. -->
        <PackageReference Include="SharpCrafters.Backstage.Commands" />

        <!-- For TestLicenseKeyProvider, which signs license keys with the test authority. -->
        <PackageReference Include="SharpCrafters.Backstage.Testing" />

        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <!-- The second process of the cross-process tests. Its files are copied to the output directory of the tests. -->
        <ProjectReference Include="../PlatformTestHelper/PlatformTestHelper.csproj" />
    </ItemGroup>

</Project>
