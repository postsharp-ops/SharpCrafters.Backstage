<Project>

    <!-- Imports Directory.Build.targets of the upper directory. Use this code in any non-root Directory.Build.* even if the file does not exit. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" Condition="Exists('$([MSBuild]::GetPathOfFileAbove(`Directory.Build.props`, `$(MSBuildThisFileDirectory)../`))')"/>

    <PropertyGroup>
        <NoWarn>$(NoWarn);NU1903</NoWarn>

        <!-- The tests are xunit.v3 applications of Microsoft.Testing.Platform, which 'Build.ps1 test' runs with
             'dotnet test' in the mode of that platform. xunit.v3 sets IsTestingPlatformApplication only when its package
             is restored. PostSharp.Engineering discovers the test applications without a restore, so it reads this
             property instead. It is set on the test projects only, whose name ends with 'Tests': the test tools and
             SharpCrafters.Backstage.Testing are not test applications. -->
        <UseMicrosoftTestingPlatformRunner Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</UseMicrosoftTestingPlatformRunner>

        <!-- Rules that xunit.v3 introduced. xUnit1051 asks every call that accepts a cancellation token to pass
             TestContext.Current.CancellationToken, and xUnit1069 asks the same of a test with a Timeout. They are
             recommendations, not defects; the tests never passed a token under xunit v2, and passing one at the
             hundreds of call sites is a change of its own. -->
        <NoWarn>$(NoWarn);xUnit1051;xUnit1069</NoWarn>
    </PropertyGroup>

</Project>
