<Project Sdk="Microsoft.NET.Sdk">

    <!-- Compiles the source files that SharpCrafters.Backstage.Infrastructure ships under shared\ exactly as a
         consumer outside this repository compiles them: by link, without METALAMA_BACKSTAGE and without
         HAS_METALAMA_TESTING_HOOKS, so the types are internal and depend on nothing but the base class library.

         Those files are shared for Metalama.Framework.CompilerExtensions and Metalama.Framework.DesignTime.Contracts,
         which can reference nothing at all, not even that package. A consumer that can take a package reference,
         such as an MSBuild task, references the package instead and compiles nothing.

         This project exists because nothing else here checks the shared form. Every project of this repository
         compiles those files with METALAMA_BACKSTAGE defined, so a file that reaches a Backstage service, or that
         keeps a public member whose type became internal, compiles here and fails in the consumer that takes it from
         the package. That is what had happened to NamedLockExtensions.cs.

         It builds no product code. It is not packed, not tested and referenced by nothing; failing to compile is the
         whole of what it does. -->

    <PropertyGroup>
        <TargetFrameworks>netframework4.7.2;netstandard2.0</TargetFrameworks>
        <IsPackable>False</IsPackable>
        <IsTestProject>False</IsTestProject>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>SharpCrafters.Backstage</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

        <!-- The files carry documentation comments, but this assembly is not shipped and its documentation would
             collide with the one of the assembly that does ship them. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- The same set as the shared\ item group of SharpCrafters.Backstage.Infrastructure.csproj. The two lists
             are kept together by the comment there; a file in one and not in the other is a file that is either
             shipped and not checked, or checked and not shipped. -->
        <Compile Include="..\..\SharpCrafters.Backstage.Infrastructure\Threading\*.cs" LinkBase="Threading" />
        <Compile Include="..\..\SharpCrafters.Backstage.Infrastructure\Diagnostics\ProcessKind.cs;..\..\SharpCrafters.Backstage.Infrastructure\Diagnostics\ProcessKindDetector.cs"
                 LinkBase="Diagnostics" />
    </ItemGroup>

    <ItemGroup>
        <!-- The one package a consumer needs, for the attributes of the annotations library. The nullable analysis
             attributes come from the embedded system types of the engineering SDK, which a consumer either imports
             or declares itself. -->
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    </ItemGroup>

</Project>
