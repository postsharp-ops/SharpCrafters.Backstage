<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The readers and writers of the weaving symbol files. It depends on nothing else of Backstage, so that the compilers
             and the Visual Studio extension reference it alone (Documentation/future/Introspection-Cli.md of PostSharp,
             section 7.1). Its only package dependency is System.Text.Json on netstandard2.0, for schema version 2, which is
             a JSON format. The framework provides System.Text.Json on net10.0. -->
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <RootNamespace>SharpCrafters.Aspects.Introspection</RootNamespace>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
        <PackageReference Include="System.Text.Json" VersionOverride="$(SystemTextJsonMinVersion)" NoWarn="NU1903" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharpCrafters.Aspects.Introspection.Tests" />
    </ItemGroup>

</Project>
